# -----------------------------------------------------------------------------
# Tech Sorcery — environment variables
# Copy this file to `.env.local` and fill in the values you have.
# Every variable is optional: the site builds and runs without any of them.
# -----------------------------------------------------------------------------

# Canonical site URL (used for metadata, canonical, OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://techsorcery.dev

# --- Contact form delivery ---------------------------------------------------
# Leave SMTP_* empty and the contact form falls back to a WhatsApp / mailto
# handoff on the client side (no server email is sent).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where contact form emails are delivered (defaults to the site email below)
CONTACT_EMAIL=theone14122000@gmail.com
# Optional: where replies should go (defaults to CONTACT_EMAIL)
CONTACT_REPLY_TO=

# Optional alternative to SMTP (https://resend.com). Used if SMTP is not set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Analytics ---------------------------------------------------------------
# Google Tag Manager container id, e.g. GTM-XXXXXXX. Leave empty to skip.
NEXT_PUBLIC_GTM_ID=

# --- Optional brand overrides ------------------------------------------------
# NEXT_PUBLIC_WHATSAPP_NUMBER=919805029089
